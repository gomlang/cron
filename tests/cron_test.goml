package tests;

use ecosystem::cron as cron;
use ecosystem::datetime as dt;
use std::testing;
use std::task;

fn schedule(text: string) -> cron::Schedule {
    testing::expect_ok(cron::Schedule::parse(text), text)
}

fn utc(text: string) -> dt::UtcInstant {
    testing::expect_ok(dt::UtcInstant::parse(text), text)
}

fn fixed(seconds: isize) -> dt::TimeZone {
    dt::TimeZone::fixed("test", testing::expect_ok(dt::Offset::from_seconds(seconds), "offset"))
}

fn next(text: string, after: string, until: string) -> dt::UtcInstant {
    testing::expect_ok(
        schedule(text).next(utc(after), fixed(0), cron::Search::new(utc(until))),
        text,
    )
}

fn equal_values(actual: Vec[isize], expected: Vec[isize]) -> () {
    testing::assert_eq(actual.len(), expected.len());
    for index in 0..actual.len() {
        testing::assert_eq(actual[index], expected[index]);
    }
}

fn equal_result(
    actual: Result[dt::UtcInstant, cron::Error],
    expected: Result[dt::UtcInstant, cron::Error],
) -> () {
    match (actual, expected) {
        (Ok(left), Ok(right)) => testing::assert_eq(left, right),
        (Err(left), Err(right)) => testing::assert_eq(left, right),
        _ => testing::fail("different result kinds"),
    }
}

#[test]
fn grammar_ranges_lists_steps_names_and_sunday_alias() -> () {
    let value = schedule("\t 5/20 1-5/2 1,15 jan-MAR MON,7\r\n");
    equal_values(value.values(cron::Field::Minute), Vec::from_array([5, 25, 45]));
    equal_values(value.values(cron::Field::Hour), Vec::from_array([1, 3, 5]));
    equal_values(value.values(cron::Field::DayOfMonth), Vec::from_array([1, 15]));
    equal_values(value.values(cron::Field::Month), Vec::from_array([1, 2, 3]));
    equal_values(value.values(cron::Field::DayOfWeek), Vec::from_array([0, 1]));
    equal_values(schedule("0 0 * * 5-7").values(cron::Field::DayOfWeek), Vec::from_array([0, 5, 6]));
    equal_values(schedule("*/9999 * * * *").values(cron::Field::Minute), Vec::from_array([0]));
}

#[test]
fn parse_rejects_malformed_and_unsupported_syntax() -> () {
    for text in Vec::from_array(
        [
            "",
            "* * * *",
            "* * * * * *",
            "@daily",
            "0 0 ? * *",
            "0 0 L * *",
            "0 0 1W * *",
            "0 0 * * mon#2",
            "60 * * * *",
            "* 24 * * *",
            "0 0 0 * *",
            "0 0 * 0 *",
            "0 0 * * 8",
            "0 0 * xyz *",
            "1,,2 * * * *",
            ",1 * * * *",
            "1, * * * *",
            "*/0 * * * *",
            "1/ * * * *",
            "1/2/3 * * * *",
            "1-2-3 * * * *",
            "2-1 * * * *",
            "*-2 * * * *",
            "+1 * * * *",
            "-1 * * * *",
            "0 0 * * fri-mon",
            "0 0 * * * #comment",
            "０ * * * *",
            "* * * * *",
            "999999999999999999999999999 * * * *",
        ],
    ) {
        testing::assert_err(cron::Schedule::parse(text));
    }
    testing::assert_err(cron::Schedule::parse(" ".repeat(4097)));
    testing::assert_ok(cron::Schedule::parse(" ".repeat(4087) + "* * * * *"));
    match testing::expect_err(cron::Schedule::parse("0 0 * 13 *"), "field") {
        cron::Error::Parse { field, message: _ } => testing::assert_eq(field, 3),
        _ => testing::fail("parse error"),
    }
}

#[test]
fn day_or_and_wildcard_contract() -> () {
    let monday = utc("2024-01-08T00:00:00Z");
    let tuesday = utc("2024-01-09T00:00:00Z");
    let friday13 = utc("2024-09-13T00:00:00Z");
    testing::assert(
        testing::expect_ok(
            schedule("0 0 13 * MON").matches(monday, fixed(0), cron::Fold::Both),
            "OR",
        ),
    );
    testing::assert(
        testing::expect_ok(
            schedule("0 0 13 * MON").matches(friday13, fixed(0), cron::Fold::Both),
            "OR",
        ),
    );
    testing::assert(
        !testing::expect_ok(
            schedule("0 0 * * MON").matches(tuesday, fixed(0), cron::Fold::Both),
            "AND",
        ),
    );
    testing::assert(
        !testing::expect_ok(
            schedule("0 0 */1 * MON").matches(tuesday, fixed(0), cron::Fold::Both),
            "AND",
        ),
    );
    testing::assert(
        testing::expect_ok(
            schedule("0 0 1-31 * MON").matches(tuesday, fixed(0), cron::Fold::Both),
            "explicit range OR",
        ),
    );
    testing::assert(
        testing::expect_ok(
            schedule("0 0 */2 * MON").matches(tuesday, fixed(0), cron::Fold::Both),
            "stepped wildcard OR",
        ),
    );
    testing::assert(
        !testing::expect_ok(
            schedule("0 0 1,*/1 * MON").matches(tuesday, fixed(0), cron::Fold::Both),
            "list wildcard AND",
        ),
    );
}

#[test]
fn next_is_strict_and_matches_has_minute_precision() -> () {
    testing::assert_eq(
        next("* * * * *", "2024-01-01T12:30:00Z", "2024-01-01T12:31:00Z"),
        utc("2024-01-01T12:31:00Z"),
    );
    testing::assert_eq(
        next("* * * * *", "2024-01-01T12:30:59.999999999Z", "2024-01-01T12:31:00Z"),
        utc("2024-01-01T12:31:00Z"),
    );
    testing::assert(
        !testing::expect_ok(
            schedule("* * * * *").matches(
                utc("2024-01-01T12:30:00.000000001Z"),
                fixed(0),
                cron::Fold::Both,
            ),
            "fraction",
        ),
    );
    testing::assert(
        !testing::expect_ok(
            schedule("* * * * *").matches(utc("2024-01-01T12:30:01Z"), fixed(0), cron::Fold::Both),
            "second",
        ),
    );
}

#[test]
fn bounds_budget_and_calendar_impossibility_are_recoverable() -> () {
    let after = utc("2024-01-01T00:00:00Z");
    let until = utc("2024-01-01T00:00:59.999999999Z");
    equal_result(
        schedule("* * * * *").next(after, fixed(0), cron::Search::new(until)),
        Result::Err(cron::Error::NoMatch),
    );
    for limit in Vec::from_array([0, -1, 10000001]) {
        match testing::expect_err(
            schedule("* * * * *").next(
                after,
                fixed(0),
                cron::Search { until, max_steps: limit, fold: cron::Fold::Both },
            ),
            "invalid",
        ) {
            cron::Error::InvalidOptions(_) => (),
            _ => testing::fail("invalid options"),
        }
    }
    equal_result(
        schedule("* * * * *").next(
            after,
            fixed(0),
            cron::Search { until, max_steps: 1, fold: cron::Fold::Both },
        ),
        Result::Err(cron::Error::WorkLimit),
    );
    testing::assert_err(schedule("* * * * *").next(after, fixed(0), cron::Search::new(after)));
    // 400 years of impossible February dates need fewer than 16000 steps.
    equal_result(
        schedule("0 0 30 FEB *").next(
            utc("2000-01-01T00:00:00Z"),
            fixed(0),
            cron::Search {
                until: utc("2400-01-01T00:00:00Z"),
                max_steps: 16000,
                fold: cron::Fold::Both,
            },
        ),
        Result::Err(cron::Error::NoMatch),
    );
    testing::assert_eq(
        next("0 0 29 FEB *", "2096-02-29T00:00:00Z", "2104-02-29T00:00:00Z"),
        utc("2104-02-29T00:00:00Z"),
    );
}

#[test]
fn historical_second_offsets_and_calendar_endpoints() -> () {
    let after = utc("2024-01-01T00:00:00Z");
    let result = testing::expect_ok(
        schedule("* * * * *").next(after, fixed(17), cron::Search::new(utc("2024-01-01T00:01:00Z"))),
        "seconds offset",
    );
    testing::assert_eq(result, utc("2024-01-01T00:00:43Z"));
    testing::assert(
        testing::expect_ok(
            schedule("* * * * *").matches(result, fixed(17), cron::Fold::Both),
            "wall minute",
        ),
    );
    testing::assert_eq(
        next("* * * * *", "0001-01-01T00:00:00Z", "0001-01-01T00:01:00Z"),
        utc("0001-01-01T00:01:00Z"),
    );
    equal_result(
        schedule("* * * * *").next(
            utc("9999-12-31T23:59:00Z"),
            fixed(0),
            cron::Search::new(utc("9999-12-31T23:59:59.999999999Z")),
        ),
        Result::Err(cron::Error::NoMatch),
    );
    for offset in Vec::from_array([-93599, 93599]) {
        let low = utc("0001-01-01T00:00:00Z");
        let high = utc("0001-01-04T00:00:00Z");
        let result = testing::expect_ok(
            schedule("* * * * *").next(low, fixed(offset), cron::Search::new(high)),
            "boundary offset",
        );
        testing::assert_eq(
            result.unix_seconds() - low.unix_seconds(),
            if offset > 0 {
                1
            } else {
                93599
            },
        );
        testing::assert(
            testing::expect_ok(
                schedule("* * * * *").matches(result, fixed(offset), cron::Fold::Both),
                "boundary match",
            ),
        );
    }
    testing::assert_eq(
        testing::expect_ok(
            schedule("* * * * *").next(
                utc("9999-12-31T23:57:00Z"),
                fixed(-93599),
                cron::Search::new(utc("9999-12-31T23:59:59Z")),
            ),
            "upper",
        ),
        utc("9999-12-31T23:57:59Z"),
    );
    testing::assert_eq(
        testing::expect_err(
            schedule("* * * * *").next(
                utc("9999-12-31T23:57:00Z"),
                fixed(93599),
                cron::Search::new(utc("9999-12-31T23:59:59Z")),
            ),
            "upper no representable local",
        ),
        cron::Error::NoMatch,
    );
    match testing::expect_err(
        schedule("* * * * *").matches(utc("9999-12-31T23:57:00Z"), fixed(93599), cron::Fold::Both),
        "local overflow",
    ) {
        cron::Error::DateTime(dt::Error::OutOfRange(_)) => (),
        _ => testing::fail("recoverable local overflow"),
    }
}

#[test]
fn work_limit_covers_proving_minimality_after_candidate_found() -> () {
    let value = schedule("0 0 1 JAN *");
    let after = utc("2023-12-31T00:00:00Z");
    let until = utc("2024-01-01T00:00:00Z");
    // Skip December, visit Jan 1, resolve midnight, visit Jan 2.
    testing::assert_eq(
        testing::expect_err(
            value.next(
                after,
                fixed(0),
                cron::Search { until, max_steps: 3, fold: cron::Fold::Both },
            ),
            "candidate alone is not proof",
        ),
        cron::Error::WorkLimit,
    );
    testing::assert_eq(
        testing::expect_ok(
            value.next(
                after,
                fixed(0),
                cron::Search { until, max_steps: 4, fold: cron::Fold::Both },
            ),
            "proof fits",
        ),
        until,
    );
}

#[test]
fn fold_selection_respects_utc_order_after_inside_first_occurrence() -> () {
    let zone = testing::expect_ok(dt::TimeZone::from_posix("NY", "EST5EDT,M3.2.0,M11.1.0"), "zone");
    let value = schedule("30 1 * * *");
    let until = utc("2024-11-05T00:00:00Z");
    let early = utc("2024-11-03T05:30:00Z");
    let late = utc("2024-11-03T06:30:00Z");
    testing::assert_eq(
        testing::expect_ok(
            value.next(utc("2024-11-03T05:45:00Z"), zone, cron::Search::new(until)),
            "fold rewind",
        ),
        late,
    );
    testing::assert_eq(
        testing::expect_ok(value.next(early, zone, cron::Search::new(until)), "strict first"),
        late,
    );
    testing::assert_eq(
        testing::expect_ok(
            value.next(
                utc("2024-11-03T05:00:00Z"),
                zone,
                cron::Search { until, max_steps: 100000, fold: cron::Fold::Later },
            ),
            "select later",
        ),
        late,
    );
    testing::assert_eq(
        testing::expect_ok(
            value.next(
                early,
                zone,
                cron::Search { until, max_steps: 100000, fold: cron::Fold::Earlier },
            ),
            "earlier already passed",
        ),
        utc("2024-11-04T06:30:00Z"),
    );
    testing::assert(
        !testing::expect_ok(value.matches(early, zone, cron::Fold::Later), "early excluded"),
    );
    testing::assert(
        !testing::expect_ok(value.matches(late, zone, cron::Fold::Earlier), "late excluded"),
    );
    testing::assert_eq(
        testing::expect_ok(
            schedule("30 2 * * *").next(
                utc("2024-03-10T06:59:00Z"),
                zone,
                cron::Search::new(utc("2024-03-12T00:00:00Z")),
            ),
            "gap skip",
        ),
        utc("2024-03-11T06:30:00Z"),
    );
}

#[test]
fn values_are_snapshots_and_handles_can_be_shared() -> () {
    let value = schedule("5,10 0 * * *");
    let copy = value;
    let minutes = value.values(cron::Field::Minute);
    minutes[0] = 59;
    minutes.clear();
    minutes.push(33);
    equal_values(copy.values(cron::Field::Minute), Vec::from_array([5, 10]));
    task::scope(
        |scope| {
            for _ in 0..8 {
                scope.spawn(
                    |_| {
                        for _ in 0..20 {
                            equal_values(copy.values(cron::Field::Minute), Vec::from_array([5, 10]));
                            testing::assert_eq(
                                testing::expect_ok(
                                    value.next(
                                        utc("2024-01-01T00:05:00Z"),
                                        fixed(0),
                                        cron::Search::new(utc("2024-01-02T00:00:00Z")),
                                    ),
                                    "concurrent next",
                                ),
                                utc("2024-01-01T00:10:00Z"),
                            );
                        }
                    },
                );
            }
        },
    );
}
